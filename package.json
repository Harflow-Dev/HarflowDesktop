{
  "name": "@harflow/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/main/index.cjs",
  "dependencies": {
    "@harflow/ui": "git+https://github.com/Harflow-Dev/HarflowUI.git#ed4e077fd4dcbac99e3a1c59d2ac56c374722b68",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dependency-cruiser": "^17.3.0",
    "electron": "^45.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p src/shared && tsc -p src/main && tsc -p src/preload && tsc -p src/renderer && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture": "node scripts/check-source-inventory.mjs && depcruise src --config .dependency-cruiser.cjs && node scripts/check-legacy-names.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "electron .",
    "smoke": "electron . --smoke"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  }
}
